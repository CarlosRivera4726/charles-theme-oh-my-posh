{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#8be9fd",
          "properties": { "style": "folder" },
          "template": "{{ .Folder }} "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#689f63",
          "template": "via 󰎙 {{ .Full }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#ffb86c",
          "properties": { "fetch_status": true },
          "template": ":: {{ .HEAD }}{{ if .Working.Changed }}*{{ end }} "
        },
        {
          "type": "exit",
          "style": "plain",
          "foreground": "#ff5555",
          "template": "✘ "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#50fa7b",
          "template": "❯ "
        }
      ]
    },
    {
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#f1fa8c",
          "properties": {
            "threshold": 500
          },
          "template": " {{ .FormattedMs }}"
        }
      ]
    }
  ]
}